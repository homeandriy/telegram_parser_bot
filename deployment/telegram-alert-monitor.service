[Unit]
Description=Telegram Alert Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-monitor
WorkingDirectory=/opt/telegram-alert-monitor
ExecStart=/usr/bin/telegram-alert-monitor --daemon --config /etc/telegram-alert-monitor/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
