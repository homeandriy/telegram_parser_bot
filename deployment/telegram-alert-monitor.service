[Unit]
Description=Telegram Alert Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-monitor
WorkingDirectory=/opt/telegram-alert-monitor
EnvironmentFile=-/etc/telegram-alert-monitor/environment
StateDirectory=telegram-alert-monitor
StateDirectoryMode=0750
ExecStart=/usr/bin/telegram-alert-monitor --daemon --config /etc/telegram-alert-monitor/config.toml --state-dir /var/lib/telegram-alert-monitor/state
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
